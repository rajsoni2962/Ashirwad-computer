generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model BusinessSettings {
  id                  String   @id @default("default") @map("_id")
  companyName         String   @default("ASHIRWAD TECHNOLOGIES")
  tagline             String   @default("Beyond Tech Limits...")
  address             String   @default("Ashraya 10, GST compound, new ranip, Ahmedabad 382470.")
  phone               String   @default("9662278994")
  email               String   @default("rajsoni2962@gmail.com")
  gstin               String   @default("")
  state               String   @default("Gujarat")
  stateCode           String   @default("24")
  bankName            String   @default("State Bank of India")
  accountNumber       String   @default("39485720194")
  ifscCode            String   @default("SBIN0001234")
  upiId               String   @default("9662278994@upi")
  invoicePrefix       String   @default("AT/2026/")
  nextInvoiceNumber   Int      @default(110)
  purchasePrefix      String   @default("PO/2026/")
  nextPurchaseNumber  Int      @default(1)
  logoUrl             String   @default("/brand/logo.jpeg")
  signatureUrl        String   @default("/brand/signature.jpeg")
  terms               String   @default("* Tested and working perfectly at the time of sale.\n* Please inspect the laptop before purchase.\n* 6 Months of warranty covers technical issues only and excludes physical or liquid damage.\n* Battery backup may vary depending on usage.\n* No return or refund after sale unless covered under warranty.\n* Thank you for choosing us—we’re always here to help if you need support.")
  footer              String   @default("Thank you for choosing us—we're always here to help if you need support.")
  authorizedSignatory String   @default("Ashirwad Technologies\nRaj Soni\nProprietor")
  geminiApiKey        String?
  openaiApiKey        String?
  visionProvider      String   @default("gemini")
  visionModel         String   @default("gemini-2.5-flash")
  invoiceDesign       String?
  updatedAt           DateTime @updatedAt
}

model BusinessProfile {
  id                  String   @id @default(cuid()) @map("_id")
  name                String
  isDefault           Boolean  @default(false)
  isActive            Boolean  @default(true)
  companyName         String   @default("ASHIRWAD TECHNOLOGIES")
  tagline             String?  @default("Beyond Tech Limits...")
  address             String   @default("Ashraya 10, GST compound, new ranip, Ahmedabad 382470.")
  phone               String   @default("9662278994")
  email               String?  @default("rajsoni2962@gmail.com")
  gstin               String?  @default("")
  state               String   @default("Gujarat")
  stateCode           String   @default("24")
  bankName            String?  @default("Kotak Mahindra Bank")
  accountNumber       String?  @default("5947557983")
  ifscCode            String?  @default("KKBK0000879")
  upiId               String?  @default("rajsoni2962-2@okaxis")
  invoicePrefix       String   @default("AT/2026/")
  nextInvoiceNumber   Int      @default(1)
  purchasePrefix      String   @default("PO/2026/")
  nextPurchaseNumber  Int      @default(1)
  logoUrl             String?  @default("/brand/logo.png")
  signatureUrl        String?  @default("/brand/signature.jpeg")
  terms               String?
  footer              String?
  authorizedSignatory String?  @default("Ashirwad Technologies\nRaj Soni\nProprietor")
  invoiceDesign       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  invoices            Invoice[]
  users               User[]

  @@index([isDefault])
  @@index([isActive])
}

model Customer {
  id             String    @id @default(cuid()) @map("_id")
  name           String
  phone          String
  email          String?
  address        String?
  gstin          String?
  state          String?   @default("Gujarat")
  stateCode      String?   @default("24")
  openingBalance Float     @default(0.0)
  currentBalance Float     @default(0.0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?

  invoices       Invoice[]
  payments       Payment[]
  serialNumbers  SerialNumber[]

  @@index([phone])
  @@index([name])
  @@index([isDeleted])
}

model Supplier {
  id              String     @id @default(cuid()) @map("_id")
  name            String
  phone           String?
  email           String?
  address         String?
  gstin           String?
  state           String?    @default("Gujarat")
  stateCode       String?    @default("24")
  openingBalance  Float      @default(0.0)
  currentBalance  Float      @default(0.0)
  notes           String?
  invoicePatterns String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  purchases      Purchase[]
  payments       Payment[]
  serialNumbers  SerialNumber[]

  @@index([phone])
  @@index([name])
}

model Product {
  id           String   @id @default(cuid()) @map("_id")
  name         String
  productType  String   @default("PHYSICAL")
  brand        String?
  model        String?
  category     String   @default("Laptop")
  cpu          String?
  generation   String?
  ram          String?
  ramType      String?
  storage      String?
  storageType  String?
  gpu          String?
  displaySize  String?
  condition    String?  @default("Refurbished")
  hsn          String?  @default("8471")
  gstPercent   Float    @default(18.0)
  purchasePrice Float   @default(0.0)
  sellingPrice Float   @default(0.0)
  minStock     Int      @default(1)
  currentStock Int      @default(0)
  warranty     String?  @default("6 Months")
  notes        String?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  deletedBy    String?

  serialNumbers SerialNumber[]
  invoiceItems  InvoiceItem[]
  purchaseItems PurchaseItem[]
  movements     StockMovement[]

  @@index([name])
  @@index([brand])
  @@index([category])
  @@index([productType])
  @@index([isDeleted])
}

model SerialNumber {
  id                String    @id @default(cuid()) @map("_id")
  serialNumber      String    @unique
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  purchaseInvoiceId String?
  purchasePrice     Float?
  purchaseDate      DateTime?
  sellingPrice      Float?
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id])
  salesInvoiceId    String?
  salesInvoice      Invoice?  @relation(fields: [salesInvoiceId], references: [id])
  saleDate          DateTime?
  warrantyStart     DateTime?
  warrantyEnd       DateTime?
  status            String    @default("In Stock")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([productId])
  @@index([customerId])
  @@index([salesInvoiceId])
}

model Invoice {
  id              String        @id @default(cuid()) @map("_id")
  invoiceNumber   String        @unique
  date            DateTime      @default(now())
  dueDate         DateTime?
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  subtotal        Float         @default(0.0)
  discountPercent Float         @default(0.0)
  discountAmount  Float         @default(0.0)
  taxableAmount   Float         @default(0.0)
  cgst            Float         @default(0.0)
  sgst            Float         @default(0.0)
  igst            Float         @default(0.0)
  grandTotal      Float         @default(0.0)
  paidAmount      Float         @default(0.0)
  balanceDue      Float         @default(0.0)
  paymentMode     String        @default("Cash")
  paymentStatus   String        @default("Paid")
  notes           String?
  terms           String?
  status          String        @default("Confirmed")
  whatsappSharedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  invoiceType       String        @default("TAX_INVOICE")
  taxConfiguration  String        @default("CGST_SGST")

  customerSnapshot  String?
  businessSnapshot  String?
  roundOff          Float         @default(0.0)
  finalTotal        Float         @default(0.0)
  templateVersion   String        @default("v1.0")
  isFinalized       Boolean       @default(true)
  finalizedAt       DateTime?     @default(now())
  revisionNumber    Int           @default(1)
  revisionReason    String?
  parentInvoiceId   String?
  pdfGeneratedAt    DateTime?
  pdfStorageUrl     String?

  isDeleted         Boolean       @default(false)
  deletedAt         DateTime?
  deletedBy         String?
  deletionReason    String?
  restoredAt        DateTime?
  restoredBy        String?

  businessProfileId String?
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id])

  items           InvoiceItem[]
  payments        Payment[]
  serialNumbers   SerialNumber[]
  shareLogs       InvoiceShareLog[]
  revisions       InvoiceRevisionAudit[]

  @@index([date])
  @@index([customerId])
  @@index([status])
  @@index([isFinalized])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([invoiceType])
  @@index([taxConfiguration])
  @@index([businessProfileId])
}

model InvoiceItem {
  id            String   @id @default(cuid()) @map("_id")
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  isInvoiceOnly Boolean  @default(false)
  serialNumber  String?
  description   String?
  productName   String?
  warranty      String?  @default("6 Months")
  itemSnapshot  String?
  hsn           String?
  quantity      Int      @default(1)
  unit          String   @default("Pcs")
  rate          Float
  discount      Float    @default(0.0)
  gstPercent    Float    @default(18.0)
  taxableAmount Float
  gstAmount     Float
  total         Float

  @@index([invoiceId])
  @@index([productId])
}

model InvoiceRevisionAudit {
  id               String   @id @default(cuid()) @map("_id")
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  revisionNumber   Int
  action           String
  changedBy        String   @default("admin")
  changeReason     String
  diffSummary      String?
  previousSnapshot String?
  newSnapshot      String
  createdAt        DateTime @default(now())

  @@index([invoiceId])
}

model Purchase {
  id                    String         @id @default(cuid()) @map("_id")
  purchaseNumber        String         @unique
  supplierInvoiceNumber String
  date                  DateTime       @default(now())
  dueDate               DateTime?
  supplierId            String
  supplier              Supplier       @relation(fields: [supplierId], references: [id])
  subtotal              Float          @default(0.0)
  discountPercent       Float          @default(0.0)
  discountAmount        Float          @default(0.0)
  taxableAmount         Float          @default(0.0)
  cgst                  Float          @default(0.0)
  sgst                  Float          @default(0.0)
  igst                  Float          @default(0.0)
  grandTotal            Float          @default(0.0)
  paidAmount            Float          @default(0.0)
  balanceDue            Float          @default(0.0)
  paymentStatus         String         @default("Unpaid")
  billFileUrl           String?
  originalFileName      String?
  documentType          String?
  aiExtractedData       String?
  verificationStatus    String         @default("VERIFIED")
  ocrRawData            String?
  notes                 String?
  status                String         @default("Confirmed")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  items                 PurchaseItem[]
  payments              Payment[]

  @@index([supplierInvoiceNumber])
  @@index([date])
  @@index([supplierId])
}

model PurchaseItem {
  id            String   @id @default(cuid()) @map("_id")
  purchaseId    String
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  serialNumbers String?
  description   String?
  hsn           String?
  quantity      Int      @default(1)
  unit          String   @default("Pcs")
  rate          Float
  discount      Float    @default(0.0)
  gstPercent    Float    @default(18.0)
  taxableAmount Float
  gstAmount     Float
  total         Float

  @@index([purchaseId])
  @@index([productId])
}

model Payment {
  id              String    @id @default(cuid()) @map("_id")
  paymentNumber   String    @unique
  date            DateTime  @default(now())
  type            String
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  invoiceId       String?
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id])
  purchaseId      String?
  purchase        Purchase? @relation(fields: [purchaseId], references: [id])
  amount          Float
  paymentMode     String    @default("Cash")
  referenceNumber String?
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([invoiceId])
  @@index([purchaseId])
  @@index([customerId])
  @@index([supplierId])
}

model StockMovement {
  id              String   @id @default(cuid()) @map("_id")
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  type            String
  referenceType   String?
  referenceId     String?
  referenceNumber String?
  quantityChange  Int
  balanceAfter    Int
  unitPrice       Float?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([date])
}

model Expense {
  id            String   @id @default(cuid()) @map("_id")
  category      String
  description   String
  amount        Float
  date          DateTime @default(now())
  paymentMethod String   @default("Cash")
  attachmentUrl String?
  notes         String?
  createdAt     DateTime @default(now())
}

model User {
  id                String           @id @default(cuid()) @map("_id")
  username          String           @unique
  name              String
  email             String?
  phone             String?
  avatarUrl         String?
  bio               String?
  password          String           @default("admin123")
  role              String           @default("admin")
  businessProfileId String?
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt @default(now())
}

model InvoiceShareLog {
  id            String   @id @default(cuid()) @map("_id")
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  channel       String   @default("WhatsApp")
  recipient     String
  customerName  String?
  invoiceNumber String?
  sharedAt      DateTime @default(now())
  status        String   @default("Shared")
}
